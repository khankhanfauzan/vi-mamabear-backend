# App
NODE_ENV=development
PORT=3001
LOG_LEVEL=info
CORS_ORIGIN=http://localhost:3000
BACKEND_URL=http://localhost:3001
FRONTEND_URL=http://localhost:3000

# Database
DATABASE_URL=postgresql://user:password@localhost:5432/mamabear?schema=public

# Auth
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=

# Mail (fallback order: BREVO_* -> SMTP_* -> MAILHOG_URL -> default)
MAILHOG_URL=
MAIL_USER=
MAIL_PASS=
MAIL_FROM=
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=

# Brevo SMTP Configuration (Production)
BREVO_SMTP_HOST=smtp-relay.brevo.com
BREVO_SMTP_PORT=587
BREVO_SMTP_USER=your_email@example.com
BREVO_SMTP_PASS=your_brevo_smtp_key
BREVO_FROM_EMAIL=your_email@example.com

# OpenRouter (AI)
OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_MODEL=
OPENROUTER_FALLBACK_MODEL=
OPENROUTER_TIMEOUT_MS=
# Provisional default; calibrate with actual catalog before release (docs/product-guardrail.md).
PRODUCT_MATCH_THRESHOLD=0.75

# Cloudinary (uploads)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Midtrans (payments)
MIDTRANS_SERVER_KEY=
MIDTRANS_CLIENT_KEY=

# RajaOngkir (shipping)
RAJAONGKIR_API_KEY=
RAJAONGKIR_BASE_URL=

# Cart cache TTL in milliseconds (optional, defaults in code)
CART_CACHE_TTL_MS=
