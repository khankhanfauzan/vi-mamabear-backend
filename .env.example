# =============================================================================
# MamaBear Backend - Environment Variables Template
# =============================================================================
# Petunjuk:
# 1. Salin file ini menjadi `.env` (`cp .env.example .env`)
# 2. Isi nilai yang sesuai untuk lingkungan lokal atau staging/production Anda.
# 3. JANGAN PERNAH commit file `.env` yang berisi kredensial asli ke Git.
# =============================================================================

# ─── Application Configuration ────────────────────────────────────────────────
# Lingkungan aplikasi: development | test | production | ci
NODE_ENV=development
# Port server backend (default fallback di kode: 3000)
PORT=3001
# Level log pino (default: info)
LOG_LEVEL=info
# Origin frontend yang diizinkan CORS (bisa URL tunggal atau comma-separated)
CORS_ORIGIN=http://localhost:3000
# Base URL backend untuk pembuatan tautan email verifikasi & webhook
BACKEND_URL=http://localhost:3001
# Base URL frontend untuk redirect/callback transaksi Midtrans
FRONTEND_URL=http://localhost:3000

# ─── Database (PostgreSQL / Prisma) ───────────────────────────────────────────
# Format: postgresql://[USER]:[PASSWORD]@[HOST]:[PORT]/[DATABASE]?schema=[SCHEMA]
# Contoh Lokal PostgreSQL:
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/mamabear?schema=public
# Contoh Neon Database / Cloud:
# DATABASE_URL=postgresql://<user>:<password>@<host>/<database>?sslmode=require&channel_binding=require

# ─── Authentication & JWT ─────────────────────────────────────────────────────
# Kunci rahasia untuk menandatangani JWT Access Token (disarankan minimal 32 karakter acak)
JWT_ACCESS_SECRET=your-jwt-access-secret-min-32-chars
# Kunci rahasia untuk menandatangani JWT Refresh Token (disarankan minimal 32 karakter acak)
JWT_REFRESH_SECRET=your-jwt-refresh-secret-min-32-chars

# ─── Email Service (Brevo / SMTP / MailHog) ───────────────────────────────────
# Opsi 1: Brevo SMTP (Rekomendasi untuk Staging & Production)
BREVO_SMTP_HOST=smtp-relay.brevo.com
BREVO_SMTP_PORT=587
BREVO_SMTP_USER=your_brevo_smtp_user@example.com
BREVO_SMTP_PASS=your_brevo_smtp_key
BREVO_FROM_EMAIL=noreply@mamabear.com

# Opsi 2: SMTP generik (dipakai jika BREVO_SMTP_* tidak di-set)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
# Alamat pengirim default jika BREVO_FROM_EMAIL tidak di-set
MAIL_FROM=noreply@mamabear.com

# Opsi 3: MailHog untuk Local Testing (Opsional, dipakai jika SMTP tidak di-set)
MAILHOG_URL=localhost
# Kredensial SMTP alternatif (fallback terakhir sebelum default)
MAIL_USER=
MAIL_PASS=

# ─── Media & Image Storage (Cloudinary) ───────────────────────────────────────
# Dapatkan kredensial di https://cloudinary.com/console
CLOUDINARY_CLOUD_NAME=your_cloudinary_cloud_name
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret

# ─── Payment Gateway (Midtrans) ───────────────────────────────────────────────
# Dapatkan kredensial di https://dashboard.midtrans.com/
# Gunakan prefix SB-Mid- untuk Sandbox / UAT
MIDTRANS_SERVER_KEY=SB-Mid-server-your_sandbox_server_key
MIDTRANS_CLIENT_KEY=SB-Mid-client-your_sandbox_client_key

# ─── Shipping & Courier (RajaOngkir / Komerce API) ────────────────────────────
# Dapatkan API key di https://rajaongkir.komerce.id/
RAJAONGKIR_API_KEY=your_rajaongkir_api_key
RAJAONGKIR_BASE_URL=https://rajaongkir.komerce.id/api/v1

# ─── AI & Embeddings (OpenRouter) ─────────────────────────────────────────────
# Dapatkan API key di https://openrouter.ai/keys
OPENROUTER_API_KEY=sk-or-v1-your_openrouter_api_key
# Base URL OpenRouter (opsional, default: https://openrouter.ai/api/v1)
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
# Model utama untuk AI Chatbot (contoh free model di OpenRouter)
OPENROUTER_MODEL=nvidia/nemotron-3.5-lightning:free
# Model cadangan jika model utama gagal/timeout (default: liquid/lfm-2.5-2.6b:free)
OPENROUTER_FALLBACK_MODEL=liquid/lfm-2.5-2.6b:free
# Timeout request OpenRouter dalam milidetik (default: 13000)
OPENROUTER_TIMEOUT_MS=13000

# ─── AI Guardrails ────────────────────────────────────────────────────────────
# Ambang batas kesesuaian produk (0.0 - 1.0, default: 0.75).
# Kalibrasi dengan katalog aktual sebelum rilis (lihat docs/product-guardrail.md).
PRODUCT_MATCH_THRESHOLD=0.75

# ─── Cache & Performance (Opsional) ───────────────────────────────────────────
# Durasi cache keranjang belanja dalam milidetik (default: 10000 = 10 detik)
CART_CACHE_TTL_MS=10000
